#!/usr/bin/env bash
# Pre-commit format hook. AUTO-FIXES the staged Go files with
# `golangci-lint fmt` (gofumpt + goimports + golines, configured in
# .golangci.yml) and re-stages them, so format drift never lands on
# master (CI's read-only lint job stays the backstop).
#
# The one case it refuses to fix: a PARTIALLY-staged Go file. Formatting
# the worktree copy and re-adding it would silently sweep the unstaged
# hunks into the commit — abort and let the user decide instead.
#
# Enable once per clone:
#   just install-hooks
#
# Skip in an emergency (CI will still block on drift):
#   git commit --no-verify

set -euo pipefail

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
((${#staged[@]})) || exit 0

if ! command -v golangci-lint >/dev/null 2>&1; then
    echo "✗ golangci-lint not found on PATH." >&2
    echo "  Install it, or bypass with: git commit --no-verify" >&2
    exit 1
fi

mapfile -t partial < <(git diff --name-only -- "${staged[@]}")
if ((${#partial[@]})); then
    echo "✗ partially-staged Go files — auto-formatting would commit their unstaged hunks:" >&2
    printf '    %s\n' "${partial[@]}" >&2
    echo "Stage or stash the remaining edits, then retry. Bypass: git commit --no-verify" >&2
    exit 1
fi

golangci-lint fmt "${staged[@]}"
git add -- "${staged[@]}"
