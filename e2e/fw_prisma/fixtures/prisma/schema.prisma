// Tiny Prisma schema for the treeman e2e test. Just one model so
// migrate runs in <1 second.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Widget {
  id    Int    @id @default(autoincrement())
  name  String
  price Float
}
