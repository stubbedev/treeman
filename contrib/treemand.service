[Unit]
Description=Treeman per-worktree DB orchestrator daemon
After=default.target

[Service]
Type=simple
# Adjust ExecStart to the absolute path of treemand on your system.
# `treeman daemon install` writes a copy of this file to
# ~/.config/systemd/user/ with ExecStart pre-populated.
ExecStart=%h/.cargo/bin/treemand
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
